import zipfile, os
src='/mnt/data/VLFDetectorApp.zip'
out='/mnt/data/VLFDetectorApp_cloud_build.zip'
workflow='''name: Build Android APK

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.2.1'

      - name: Build debug APK
        run: gradle --no-daemon :app:assembleDebug

      - name: Upload debug APK
        uses: actions/upload-artifact@v4
        with:
          name: VLFDetectorApp-debug-apk
          path: app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
'''
readme_add='''\n## Cloud APK builds\n\nGitHub Actions builds a debug APK on every push and pull request, and on demand via **Actions → Build Android APK → Run workflow**. Download `VLFDetectorApp-debug-apk` from the workflow run's artifacts.\n'''
with zipfile.ZipFile(src,'r') as zin, zipfile.ZipFile(out,'w',zipfile.ZIP_DEFLATED) as zout:
    for item in zin.infolist():
        if item.filename in ('VLFDetectorApp/.github/workflows/build_apk.yml','VLFDetectorApp/README.md'):
            continue
        zout.writestr(item, zin.read(item.filename))
    zout.writestr('VLFDetectorApp/.github/workflows/build_apk.yml',workflow)
    old=zin.read('VLFDetectorApp/README.md').decode('utf-8')
    zout.writestr('VLFDetectorApp/README.md',old.rstrip()+'\n'+readme_add)
print('created',out,'bytes',os.path.getsize(out))